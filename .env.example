# Docker Compose reads .env automatically. Native Python uses exported env vars.
MRC_ENV=development
# REQUIRED for production. Generate once: python3 -c 'import secrets; print(secrets.token_hex(32))'
# Keep the same secret across restarts/deployments.
SECRET_KEY=

# Your domain, pointing to the server. Used by compose.production.yaml / Caddy.
DOMAIN=rooms.example.com

# Optional TURN service. Credentials here are sent to room participants.
ICE_SERVERS_JSON='[{"urls":"stun:stun.l.google.com:19302"}]'

# Native Python defaults (Docker configures these itself):
# HOST=127.0.0.1
# PORT=8010
# MRC_DATA_DIR=/var/lib/mrc-rooms
# COOKIE_SECURE=1
